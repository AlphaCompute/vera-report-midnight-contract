pragma language_version >= 0.22.0;

import CompactStandardLibrary;

export ledger evidenceCount: Counter;
export ledger evidenceAccumulator: Bytes<32>;
export ledger nullifierAccumulator: Bytes<32>;
// Public commitments, never plaintext evidence or reporter identifiers.
export ledger submittedEvidence: Set<Bytes<32>>;
export ledger usedNullifiers: Set<Bytes<32>>;

export circuit submitEvidence(evidenceHash: Bytes<32>, nullifier: Bytes<32>): [] {
  assert(!usedNullifiers.member(disclose(nullifier)), "Nullifier already used");
  usedNullifiers.insert(disclose(nullifier));
  submittedEvidence.insert(disclose(evidenceHash));
  nullifierAccumulator = disclose(persistentHash<Vector<2, Bytes<32>>>([nullifier, nullifierAccumulator]));
  evidenceAccumulator = disclose(persistentHash<Vector<2, Bytes<32>>>([evidenceHash, evidenceAccumulator]));
  evidenceCount.increment(1);
}

export circuit verifySubmission(evidenceHash: Bytes<32>, expectedAccumulator: Bytes<32>): Uint<8> {
  assert(evidenceAccumulator == disclose(expectedAccumulator), "Accumulator mismatch");
  assert(submittedEvidence.member(disclose(evidenceHash)), "Evidence not submitted");
  return 1;
}
